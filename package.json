{
  "name": "vpoll",
  "version": "1.0.0",
  "description": "vPoll - A Discord bot for managing tournament voting polls",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "deploy-commands": "ts-node src/deploy-commands.ts",
    "test-sheets": "ts-node src/test-sheets.ts",
    "populate-test-sheet": "ts-node src/populate-test-sheet.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "poll",
    "voting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "googleapis": "^164.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
